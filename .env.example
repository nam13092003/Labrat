# Thường do install.py sinh ra. Nếu tự điền: sao chép thành .env, chmod 600, KHÔNG commit.

# ---- Kaggle: nhiều tài khoản chạy song song (mỗi tài khoản 1 kernel GPU, ~30h/tuần riêng)
KAGGLE_ACCOUNTS=acc1,acc2,acc3
KAGGLE_ACC1_USERNAME=
KAGGLE_ACC1_TOKEN=
KAGGLE_ACC2_USERNAME=
KAGGLE_ACC2_TOKEN=
KAGGLE_ACC3_USERNAME=
KAGGLE_ACC3_TOKEN=
# Tùy chọn: KAGGLE_ACC1_KEY=... (key kiểu cũ thay cho TOKEN), KAGGLE_ACC1_WEEKLY_HOURS=30

# ---- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Harness / API provider (install.py điền theo lựa chọn), ví dụ:
# Claude Code + Anthropic:  ANTHROPIC_API_KEY=
# Claude Code + DeepSeek:   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic  ANTHROPIC_AUTH_TOKEN=
# Codex + OpenAI:           OPENAI_API_KEY=
# OpenCode / DeepSeek Harness: DEEPSEEK_API_KEY=  (hoặc <PROVIDER>_API_KEY)

# ---- Tùy chọn
S2_API_KEY=
# Token Hugging Face để tải dataset gated/private
HF_TOKEN=
